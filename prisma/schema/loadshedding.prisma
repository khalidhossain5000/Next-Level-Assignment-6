model LoadShedding {
	id        String             @id @default(uuid())
	title     String
	startTime DateTime
	endTime   DateTime
	status    LoadSheddingStatus  @default(SCHEDULED)
	reason    String?             @default("N/A")
	areaId    String
	area      Area               @relation("AreaLoadSheddings", fields: [areaId], references: [id], onDelete: Cascade, onUpdate: Cascade)

	@@index([areaId], name: "idx_load_shedding_area_id")
	@@index([status, startTime], name: "idx_load_shedding_status_start_time")
	@@map("LoadSheddings")
}