model Area {
    id          String     @id @default(uuid())
    name        String
    code        String      @db.VarChar(10) @unique
    address     String
    status      ZoneStatus @default(ACTIVE)
    feederId    String
    feeder      Feeder     @relation("FeederAreas", fields: [feederId], references: [id],onDelete: Cascade,onUpdate: Cascade)
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt

    @@index([name], name: "idx_area_name")
    @@index([code], name: "idx_area_code")
    @@index([feederId], name: "idx_area_feeder_id")
    @@map("Areas")
}