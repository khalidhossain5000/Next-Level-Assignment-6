model Area {
  id        String               @id @default(uuid())
  name      String
  code      String               @unique @db.VarChar(10)
  address   String
  status    InfrastructureStatus @default(ACTIVE)
  feederId  String
  feeder    Feeder               @relation("FeederAreas", fields: [feederId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  loadSheddings LoadShedding[]    @relation("AreaLoadSheddings")
  plannedOutages PlannedOutage[]   @relation("AreaPlannedOutages")
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([name], name: "idx_area_name")
  @@index([code], name: "idx_area_code")
  @@index([feederId], name: "idx_area_feeder_id")
  @@map("Areas")
}
