model Substation {
    id          String       @id @default(uuid())
    name        String
    capacity    String
    code        String       @db.VarChar(10) @unique
    location    String
    status      InfrastructureStatus?   @default(ACTIVE)
    //foregin key making realtien with zone
    zoneId      String
    zone        Zone         @relation(fields: [zoneId], references: [id],onDelete: Cascade,onUpdate: Cascade)


    feeders     Feeder[]     @relation("SubstationFeeders")



    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt

    @@index([name], name: "idx_substation_name")
    @@index([code], name: "idx_substation_code")
    @@index([zoneId], name: "idx_substation_zone_id")
    @@map("Substations")
}