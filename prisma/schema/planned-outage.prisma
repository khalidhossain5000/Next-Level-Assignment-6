model PlannedOutage {
    id          String             @id @default(uuid())
    title       String
    reason      String
    description String
    status      PlannedOutageStatus @default(SCHEDULED)
    startTime   DateTime
    endTime     DateTime
    areaId      String
    area        Area               @relation("AreaPlannedOutages", fields: [areaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    createdAt   DateTime           @default(now())
    updatedAt   DateTime           @updatedAt

    @@index([areaId], name: "idx_planned_outage_area_id")
    @@index([status, startTime], name: "idx_planned_outage_status_start_time")
    @@index([startTime, endTime], name: "idx_planned_outage_start_end_time")
    @@map("PlannedOutages")
}