model Outage {
  id             String         @id @default(uuid())
  cause          String
  description    String
  priority       OutagePriority @default(NORMAL)
  reported_At    DateTime       @default(now())
  status         OutageStatus   @default(REPORTED)
  acknowledgedAt DateTime?
  startedAt      DateTime?
  isDeleted      Boolean        @default(false)
  //foreign key of user to know which user reported unexpected outage
  userId         String
  user           User           @relation(  "OutageReporter",fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  payments       Payment[]      @relation("OutagePayments")

  //technican foregin key to know which technican is assigned to this outage
  technicianId String?
  techician    User? @relation(    "OutageTechnician",fields: [technicianId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId], name: "idx_outage_user_id")
  @@index([technicianId], name: "idx_outage_technician_id")
  @@index([status, createdAt], name: "idx_outage_status_created_at")
  @@index([priority], name: "idx_outage_priority")
  @@map("Outages")
}
