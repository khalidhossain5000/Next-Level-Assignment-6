model Outage {
  id             String         @id @default(uuid())
  cause          String
  description    String
  priority       OutagePriority @default(NORMAL)
  reported_At    DateTime       @default(now())
  status         OutageStatus   @default(REPORTED)
  acknowledgedAt DateTime?
  startedAt      DateTime?
  isDeleted      Boolean        @default(false)
  //foreign key of user to know which user reported unexpected outage
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  //technican foregin key to know which technican is assigned to this outage
  technicianId String
  techician    TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
