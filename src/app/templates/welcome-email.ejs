<title>Email Verified - Welcome</title>

<!-- Font Awesome -->
<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
/>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 0;
        background-color: #f4f7f6;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
    }

    .email-wrapper {
        width: 100%;
        padding: 40px 16px;
    }

    .email-container {
        max-width: 620px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    }

    /* Header */
    .header {
        background-color: #0f766e;
        padding: 34px 30px;
        text-align: center;
    }

    .logo {
        width: 68px;
        height: 68px;
        margin: 0 auto 18px;
        background-color: #ffffff;
        border-radius: 50%;
        text-align: center;
    }

    .logo i {
        color: #f59e0b;
        font-size: 30px;
        line-height: 68px;
    }

    .header h1 {
        margin: 0;
        color: #ffffff;
        font-size: 28px;
        line-height: 1.3;
        font-weight: 700;
    }

    .header p {
        margin: 10px 0 0;
        color: #d1fae5;
        font-size: 14px;
        line-height: 1.6;
    }

    /* Content */
    .content {
        padding: 38px 32px;
    }

    .greeting {
        margin: 0 0 16px;
        color: #111827;
        font-size: 22px;
        line-height: 1.4;
        font-weight: 700;
    }

    .message {
        margin: 0 0 24px;
        color: #4b5563;
        font-size: 15px;
        line-height: 1.8;
    }

    /* Verification Success */
    .success-box {
        margin: 26px 0;
        padding: 22px 20px;
        background-color: #ecfdf5;
        border: 1px solid #a7f3d0;
        border-radius: 10px;
        text-align: center;
    }

    .success-icon {
        width: 48px;
        height: 48px;
        margin: 0 auto 12px;
        background-color: #0f766e;
        border-radius: 50%;
        text-align: center;
    }

    .success-icon i {
        color: #ffffff;
        font-size: 22px;
        line-height: 48px;
    }

    .success-box h3 {
        margin: 0 0 7px;
        color: #065f46;
        font-size: 17px;
    }

    .success-box p {
        margin: 0;
        color: #047857;
        font-size: 13px;
        line-height: 1.6;
    }

    /* Features */
    .features-title {
        margin: 30px 0 18px;
        color: #111827;
        font-size: 18px;
    }

    .feature {
        display: table;
        width: 100%;
        margin-bottom: 17px;
    }

    .feature-icon {
        display: table-cell;
        width: 46px;
        vertical-align: middle;
    }

    .icon-circle {
        width: 38px;
        height: 38px;
        background-color: #f0fdfa;
        border-radius: 50%;
        text-align: center;
    }

    .icon-circle i {
        color: #0f766e;
        font-size: 16px;
        line-height: 38px;
    }

    .feature-content {
        display: table-cell;
        padding-left: 12px;
        vertical-align: middle;
    }

    .feature-content strong {
        display: block;
        margin-bottom: 3px;
        color: #1f2937;
        font-size: 14px;
    }

    .feature-content span {
        color: #6b7280;
        font-size: 13px;
        line-height: 1.5;
    }

    /* CTA */
    .cta-wrapper {
        margin: 34px 0 8px;
        text-align: center;
    }

    .cta-button {
        display: inline-block;
        padding: 14px 28px;
        background-color: #0f766e;
        border-radius: 8px;
        color: #ffffff !important;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
    }

    .cta-button i {
        margin-right: 7px;
    }

    .login-note {
        margin-top: 12px;
        color: #9ca3af;
        font-size: 12px;
    }

    /* Footer */
    .footer {
        padding: 24px 30px;
        background-color: #f8fafc;
        border-top: 1px solid #e5e7eb;
        text-align: center;
    }

    .footer p {
        margin: 5px 0;
        color: #6b7280;
        font-size: 12px;
        line-height: 1.6;
    }

    .footer .brand {
        color: #0f766e;
        font-weight: 700;
    }

    .social-icons {
        margin: 0 0 15px;
    }

    .social-icons a {
        display: inline-block;
        width: 32px;
        height: 32px;
        margin: 0 4px;
        background-color: #e5e7eb;
        border-radius: 50%;
        color: #4b5563;
        text-decoration: none;
        font-size: 13px;
        line-height: 32px;
    }

    @media only screen and (max-width: 600px) {
        .email-wrapper {
            padding: 20px 10px;
        }

        .header {
            padding: 28px 20px;
        }

        .header h1 {
            font-size: 24px;
        }

        .content {
            padding: 30px 22px;
        }

        .greeting {
            font-size: 20px;
        }
    }
</style>
```

</head>

<body>

```
<div class="email-wrapper">

    <div class="email-container">

        <!-- Header -->
        <div class="header">

            <div class="logo">
                <i class="fa-solid fa-bolt"></i>
            </div>

            <h1>Welcome Aboard!</h1>

            <p>
                Your account is verified and ready to go.
            </p>

        </div>


        <!-- Main Content -->
        <div class="content">

            <h2 class="greeting">
                Hello, <%= name %>! 👋
            </h2>

            <p class="message">
                Welcome to our
                <strong>Load Shedding & Power Management System</strong>.
                We're happy to have you with us.
            </p>


            <!-- Verification Success -->
            <div class="success-box">

                <div class="success-icon">
                    <i class="fa-solid fa-check"></i>
                </div>

                <h3>Email Successfully Verified</h3>

                <p>
                    Your email address has been verified successfully.
                    Your account is now active and ready to use.
                </p>

            </div>


            <p class="message">
                You can now access the platform and stay informed about
                power distribution, load shedding schedules, outages,
                and other important power-related updates.
            </p>


            <!-- Features -->
            <h3 class="features-title">
                What you can do
            </h3>


            <div class="feature">

                <div class="feature-icon">
                    <div class="icon-circle">
                        <i class="fa-solid fa-calendar-days"></i>
                    </div>
                </div>

                <div class="feature-content">
                    <strong>Monitor Load Shedding</strong>

                    <span>
                        View and monitor scheduled load shedding
                        information for your assigned areas.
                    </span>
                </div>

            </div>


            <div class="feature">

                <div class="feature-icon">
                    <div class="icon-circle">
                        <i class="fa-solid fa-power-off"></i>
                    </div>
                </div>

                <div class="feature-content">
                    <strong>Track Power Outages</strong>

                    <span>
                        Stay informed about unexpected outages and
                        power restoration activities.
                    </span>
                </div>

            </div>


            <div class="feature">

                <div class="feature-icon">
                    <div class="icon-circle">
                        <i class="fa-solid fa-bolt"></i>
                    </div>
                </div>

                <div class="feature-content">
                    <strong>Power Distribution</strong>

                    <span>
                        Access information about zones, substations,
                        feeders, and service areas.
                    </span>
                </div>

            </div>


            <div class="feature">

                <div class="feature-icon">
                    <div class="icon-circle">
                        <i class="fa-solid fa-bell"></i>
                    </div>
                </div>

                <div class="feature-content">
                    <strong>Receive Updates</strong>

                    <span>
                        Get important notifications about load shedding,
                        outages, and power-related events.
                    </span>
                </div>

            </div>


            <!-- CTA -->
            <div class="cta-wrapper">

                <a href="YOUR_FRONTEND_URL/login" class="cta-button">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    Login to Your Account
                </a>

                <div class="login-note">
                    Your account is fully verified and ready to use.
                </div>

            </div>

        </div>


        <!-- Footer -->
        <div class="footer">

            <div class="social-icons">

                <a href="#">
                    <i class="fa-brands fa-facebook-f"></i>
                </a>

                <a href="#">
                    <i class="fa-brands fa-linkedin-in"></i>
                </a>

                <a href="#">
                    <i class="fa-brands fa-x-twitter"></i>
                </a>

            </div>

            <p>
                Thank you for joining
                <span class="brand">
                    Power Management System
                </span>.
            </p>

            <p>
                This is an automated email. Please do not reply to this message.
            </p>

            <p>
                &copy; <%= new Date().getFullYear() %>
                Power Management System. All rights reserved.
            </p>

        </div>

    </div>

</div>
```

